# Mors.ai — environment configuration
# Copy this file to `.env` in the PROJECT ROOT (that is where app/config.py reads it).
# Every key maps 1:1 to a field in backend/app/config.py (no prefix).
# Production uses `prod.env.example` instead — `python tools/build_release.py`
# writes `release/.env` from it and refuses a development SECRET_KEY or rate limit.

# --------------------------------------------------------------------- app
# development | test | production
APP_ENV=development
DEBUG=true
API_PREFIX=/api
# comma-separated list, must include the frontend origin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----------------------------------------------------------------- storage
# SQLite by default; use postgresql+psycopg2://... only after reading docs/DATABASE.md
# NOTE: config.py resolves paths from the PROJECT ROOT (where this file lives)
DATABASE_URL=sqlite:///C:/path/to/mors.ai/mors.db
# absolute path recommended in production
UPLOAD_DIR=C:/path/to/mors.ai/uploads
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_TYPES=pdf,png,jpg,jpeg,webp,txt,md

# -------------------------------------------------------------- security
# REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-production
ACCESS_TOKEN_TTL_MINUTES=720
REFRESH_TOKEN_TTL_DAYS=30
PBKDF2_ITERATIONS=260000
RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=30

# -------------------------------------------------------------------- ai
# mock = works offline with no key (deterministic); gemini = real model
AI_PROVIDER=mock
GEMINI_API_KEY=
AI_MODEL=gemini-flash-latest
AI_FAST_MODEL=gemini-flash-latest
AI_REASONING_MODEL=gemini-flash-latest
AI_VISION_MODEL=gemini-flash-latest
AI_DAILY_TOKEN_BUDGET=400000
AI_CACHE_TTL_SECONDS=600
AI_TIMEOUT_SECONDS=45
AI_MAX_HISTORY_MESSAGES=12

# ------------------------------------------------------------------ voice
# browser = Web Speech API in the student's browser (no key needed)
AI_TTS_PROVIDER=browser
AI_STT_PROVIDER=browser
AI_TTS_VOICE=system
AI_VOICE_MAX_CHARS=800

# ------------------------------------------------------------- scheduling
# background jobs: auto-publish due content, close stale sessions, rate counters
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30

# -------------------------------------------------------------------- rag
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=6
RAG_MIN_SCORE=0.12

# ------------------------------------------------------------------- misc
DEFAULT_TIMEZONE=Asia/Baghdad
DEFAULT_LANGUAGE=ar
# true = seed demo curriculum + demo@mors.ai / admin@mors.ai on first boot
DEMO_DATA=true
