# Mors.ai — PRODUCTION environment
# Copy this file to `.env` in the PROJECT ROOT (that is where app/config.py reads it),
# or let `python tools/build_release.py` write `release/.env` from it.
# Every key maps 1:1 to a field in backend/app/config.py (no prefix).
#
# Values a production process REFUSES to boot with (app/main.py):
#   - a development SECRET_KEY
#   - RATE_LIMIT_PER_MINUTE=0 or AI_RATE_LIMIT_PER_MINUTE=0
# Values it boots with but logs loudly as leftovers:
#   DEMO_DATA=true, DEBUG=true, AI_PROVIDER=mock, rate limit > 300, CORS_ORIGINS=*

# --------------------------------------------------------------------- app
APP_ENV=production
DEBUG=false
API_PREFIX=/api
# the frontend origin only — "*" is reported as a leftover
CORS_ORIGINS=http://localhost:3000

# ----------------------------------------------------------------- storage
# keep the database and uploads OUTSIDE the code tree so upgrades never touch them
DATABASE_URL=sqlite:///C:/mors/data/mors.db
UPLOAD_DIR=C:/mors/uploads
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_TYPES=pdf,png,jpg,jpeg,webp,txt,md

# -------------------------------------------------------------- security
# REQUIRED — python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=720
REFRESH_TOKEN_TTL_DAYS=30
PBKDF2_ITERATIONS=260000
RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=30

# -------------------------------------------------------------------- ai
# gemini = real model, mock = canned answers (logged as a leftover in production)
AI_PROVIDER=gemini
# comma-ordered fallback chain; a missing key is skipped, never guessed
AI_PROVIDERS=gemini,groq,openrouter,ollama
GEMINI_API_KEY=
AI_MODEL=gemini-flash-lite-latest
AI_FAST_MODEL=gemini-flash-lite-latest
AI_REASONING_MODEL=gemini-flash-lite-latest
AI_VISION_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=8192
AI_DAILY_TOKEN_BUDGET=400000
AI_CACHE_TTL_SECONDS=600
AI_TIMEOUT_SECONDS=45
AI_MAX_HISTORY_MESSAGES=12

# ------------------------------------------------------------------ voice
# browser = the student's own Web Speech API, no key, nothing to break
AI_TTS_PROVIDER=browser
AI_STT_PROVIDER=browser
AI_TTS_VOICE=system
AI_VOICE_MAX_CHARS=800

# ------------------------------------------------------------- scheduling
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30

# -------------------------------------------------------------------- rag
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=6
RAG_MIN_SCORE=0.12

# ------------------------------------------------------------------- misc
DEFAULT_TIMEZONE=Asia/Baghdad
DEFAULT_LANGUAGE=ar
# production never seeds the demo curriculum or demo@mors.ai / admin@mors.ai.
# create the first administrator with:  python tools/create_admin.py
DEMO_DATA=false
